# Minimal iOS CMake toolchain for ET: Legacy
set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0" CACHE STRING "Minimum iOS deployment target")
set(CMAKE_OSX_ARCHITECTURES "arm64" CACHE STRING "iOS architectures")
set(CMAKE_XCODE_ATTRIBUTE_ONLY_ACTIVE_ARCH "NO")
set(IOS TRUE CACHE BOOL "iOS build")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
